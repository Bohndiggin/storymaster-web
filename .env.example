# Storymaster runtime config — used by docker-compose and the bare-metal
# systemd unit alike. Copy to `.env` and edit. **Do not commit the real .env.**

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL. The +psycopg suffix selects the v3 driver.
# For the in-compose Postgres sidecar, the host is `postgres` (the service
# name); for an external Postgres, use the host's IP/DNS.
STORYMASTER_DB_URL=postgresql+psycopg://storymaster:CHANGEME@host.docker.internal:5432/storymaster

# --- Sync / device pairing -------------------------------------------------
# Used to sign device-pairing tokens. Generate with:
#     python -c 'import secrets; print(secrets.token_urlsafe(48))'
SYNC_SECRET_KEY=replace-me-with-a-long-random-string

# --- CORS -------------------------------------------------------------------
# Same-origin (host nginx serves the SPA from the same hostname) doesn't
# need this. Set when the frontend lives on a different origin.
# STORYMASTER_CORS_ORIGINS=https://storymaster.example.com

# --- Optional: in-compose Postgres -----------------------------------------
# Only needed if you uncomment the `postgres` service in docker-compose.yml.
# POSTGRES_PASSWORD=CHANGEME
