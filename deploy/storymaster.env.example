# Storymaster runtime config. Copy to /etc/storymaster/storymaster.env and
# tighten file permissions: `install -m 600 -o root -g storymaster <src> <dst>`.

# --- Database -----------------------------------------------------------
# SQLAlchemy URL. The +psycopg suffix selects the v3 driver.
STORYMASTER_DB_URL=postgresql+psycopg://storymaster:CHANGEME@localhost:5432/storymaster

# --- API server ---------------------------------------------------------
# Bind addr — keep 127.0.0.1 so only nginx reaches it.
STORYMASTER_HOST=127.0.0.1
STORYMASTER_PORT=8765
# Don't enable in production — uvicorn reload watches the filesystem.
# STORYMASTER_RELOAD=

# --- CORS / cookies -----------------------------------------------------
# Comma-separated list of frontend origins. Same-origin (nginx-served SPA)
# doesn't need this set; required only if the frontend lives elsewhere.
# STORYMASTER_CORS_ORIGINS=https://storymaster.example.com

# --- Sync / device pairing ---------------------------------------------
# Stays at the legacy value if not set; rotate by pushing a new env and
# restarting the service. Mobile-paired devices keep their tokens.
SYNC_SECRET_KEY=replace-with-a-long-random-string
