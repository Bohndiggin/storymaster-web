[Unit]
Description=Storymaster Postgres backup
Documentation=file:///opt/storymaster/scripts/backup_postgres.sh
After=postgresql.service

[Service]
Type=oneshot
User=storymaster
Group=storymaster
EnvironmentFile=/etc/storymaster/storymaster.env
Environment=BACKUP_DIR=/var/backups/storymaster
Environment=RETENTION_DAYS=14
ExecStart=/bin/bash /opt/storymaster/scripts/backup_postgres.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/storymaster
ProtectHome=true
